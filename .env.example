# Copy this file to .env next to the project (or the container working directory).
# The app also reads plain environment variables, so in production you can
# export these directly instead of using a .env file.

# PostgreSQL connection string (required). Both forms work:
ConnectionStrings__Default=postgresql://postgres:postgres@localhost:5432/timeblock
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=timeblock;Username=postgres;Password=postgres

# JWT settings (set a strong random key of 32+ chars in production)
Jwt__Key=replace-with-a-long-random-signing-key
Jwt__Issuer=timeblock

# Optional: switch the EF Core provider (Postgres by default)
# Database__Provider=Postgres

# Optional: disable the background worker
# Worker__Enabled=true
